/*
Get the calculator display from HTML.

document.getElementById("display")
finds the HTML element whose id is "display".
*/
const display = document.getElementById("display");


/*
This function adds a number/operator
to the calculator display.

Example:
display = "12"
user clicks "+"
display becomes "12+"
*/
function appendValue(value) {
    display.value += value;
}


/*
Clear the complete calculator display.
*/
function clearDisplay() {
    display.value = "";
}


/*
Remove only the last character.

Example:
1234 → 123
*/
function deleteLast() {
    display.value = display.value.slice(0, -1);
}


/*
Calculate the result.

eval() evaluates a JavaScript mathematical expression.

Example:
"10+5" becomes 15.

NOTE:
eval() is okay for this small learning project,
but it should generally be avoided in real-world
applications when working with untrusted user input.
*/
function calculate() {

    try {

        // Do nothing if display is empty
        if (display.value === "") {
            return;
        }

        // Calculate expression and show result
        display.value = eval(display.value);

    } catch (error) {

        // If expression is invalid
        display.value = "Error";
    }
}